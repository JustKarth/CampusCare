# Database Configuration (supports local or cloud MySQL like Aiven/Railway/AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=campus_care

# Optional: Cloud Database URL (if provided, overrides individual DB_* settings above)
# DATABASE_URL=mysql://user:pass@host:port/campus_care

# Optional: Set to 'true' if using a cloud MySQL host that requires SSL
# DB_SSL=true

# JWT Secret Key (Generate a random 64-char string for production)
JWT_SECRET=your_super_secret_jwt_key_generate_one_for_production

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
